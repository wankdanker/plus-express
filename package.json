{
  "name": "plus-express",
  "version": "3.1.0",
  "description": "Express.js enhanced with type-safe validation and automatic OpenAPI documentation",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx ./example.ts",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "preversion": "node scripts/changelog.mjs check",
    "version": "node scripts/changelog.mjs release && git add CHANGELOG.md"
  },
  "keywords": [
    "express",
    "openapi",
    "swagger",
    "validation",
    "zod",
    "typescript",
    "api"
  ],
  "author": "Dan VerWeire",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wankdanker/plus-express.git"
  },
  "bugs": {
    "url": "https://github.com/wankdanker/plus-express/issues"
  },
  "homepage": "https://github.com/wankdanker/plus-express#readme",
  "peerDependencies": {
    "express": "^4.17.1 || ^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "extend": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/extend": "^3.0.4",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "express": "^5.3.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.7+sha512.ba98abc585539933375b5971f4bc6d6c73a1b4b7edc4a879e7d102fe5423d1e02309d67c60a11f04955093a96e521ad9c3b138cdd654ca5be563f378b3ae48bd"
}
